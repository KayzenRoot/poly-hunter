# Local Docker development only. These defaults are not production credentials.
POSTGRES_USER=polyhunter
POSTGRES_PASSWORD=polyhunter-local-only
POSTGRES_DB=polyhunter_dev

# Supabase Auth (PH-M01-WO-002). Local Docker starts fine WITHOUT these;
# auth-dependent endpoints fail closed (503/401) until they are provided.
# Publishable values only — never place a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side app origin used to build OAuth callback URLs.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
