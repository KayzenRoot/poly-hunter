{
  "name": "polyhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <27"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/db",
    "packages/testkit",
    "packages/polymarket",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "docker:up": "docker compose --project-name polyhunter-local up -d",
    "docker:down": "docker compose --project-name polyhunter-local down",
    "docker:rebuild": "docker compose --project-name polyhunter-local up -d --build --force-recreate",
    "docker:ps": "docker compose --project-name polyhunter-local ps",
    "docker:logs": "docker compose --project-name polyhunter-local logs --follow --tail=100",
    "db:migrate": "docker compose --project-name polyhunter-local exec -T web npm run db:migrate --workspace @polyhunter/db",
    "db:test:integration": "docker compose --project-name polyhunter-local exec -T web npm run test:integration",
    "lint": "biome lint .",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false --reporter=summary .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "npm run build --workspaces --if-present",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@polyhunter/testkit": "0.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "nodemon": "3.1.14",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "4.0.3"
    },
    "drizzle-kit": {
      "esbuild": "0.28.2",
      "@esbuild-kit/esm-loader": {
        "@esbuild-kit/core-utils": {
          "esbuild": "0.28.2"
        }
      }
    }
  }
}
