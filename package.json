{
  "name": "polyhunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22 <27"
  },
  "workspaces": [
    "packages/contracts",
    "packages/domain",
    "packages/testkit",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false --reporter=summary .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm audit --audit-level=high"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@polyhunter/testkit": "0.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
