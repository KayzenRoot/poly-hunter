{
  "name": "@polyhunter/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server/identity": {
      "types": "./src/server/identity.ts",
      "import": "./src/server/identity.ts",
      "default": "./src/server/identity.ts"
    },
    "./server/authorization": {
      "types": "./src/server/authorization.ts",
      "import": "./src/server/authorization.ts",
      "default": "./src/server/authorization.ts"
    },
    "./server/vault": {
      "types": "./src/server/vault/index.ts",
      "import": "./src/server/vault/index.ts",
      "default": "./src/server/vault/index.ts"
    },
    "./server/vault/envelope": {
      "types": "./src/server/vault/envelope.ts",
      "import": "./src/server/vault/envelope.ts",
      "default": "./src/server/vault/envelope.ts"
    },
    "./server/vault/keyring": {
      "types": "./src/server/vault/keyring.ts",
      "import": "./src/server/vault/keyring.ts",
      "default": "./src/server/vault/keyring.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@polyhunter/contracts": "0.0.0",
    "@polyhunter/domain": "0.0.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
