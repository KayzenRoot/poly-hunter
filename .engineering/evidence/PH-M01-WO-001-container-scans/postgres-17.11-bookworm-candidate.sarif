            {
              "id": "CVE-2026-56853",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-56853"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-56853?s=golang&n=stdlib&t=golang&vr=%3C1.25.13",
              "help": {
                "text": "When a server is configured to support unencrypted HTTP/2, it reads a few bytes from each new connection to see if they contain the HTTP/2 client preface. ReadHeaderTimeout is unexpectedly not being applied when doing this.\n",
                "markdown": "> When a server is configured to support unencrypted HTTP/2, it reads a few bytes from each new connection to see if they contain the HTTP/2 client preface. ReadHeaderTimeout is unexpectedly not being applied when doing this.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.24.6  |\n|Affected range  <1.25.13                  |\n|Fixed version   1.25.13                   |\n"
              },
              "properties": {
                "affected_version": "<1.25.13",
                "cvssV3_severity": "HIGH",
                "fixed_version": "1.25.13",
                "purls": [
                  "pkg:golang/stdlib@1.24.6"
                ],
                "security-severity": "7.5",
                "tags": [
                  "HIGH"
                ]
              }
            },
            {
              "id": "CVE-2026-56859",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-56859"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-56859?s=golang&n=stdlib&t=golang&vr=%3C1.25.13",
              "help": {
                "text": "Previously, DecodeElement would reset the depth counter causing it to never fire; this could lead to stack exhaustion.\n",
                "markdown": "> Previously, DecodeElement would reset the depth counter causing it to never fire; this could lead to stack exhaustion.\n\n|                                          |\n|Package         pkg:golang/stdlib@1.24.6  |\n|Affected range  <1.25.13                  |\n|Fixed version   1.25.13                   |\n"
              },
              "properties": {
