            {
              "id": "CVE-2026-39824",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-39824"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-39824?s=golang&n=sys&ns=golang.org%2Fx&t=golang&vr=%3C0.44.0",
              "help": {
                "text": "NewNTUnicodeString does not check for string length overflow. When provided with a string that overflows the maximum size of a NTUnicodeString (a 16-bit number of bytes), it returns a truncated string rather than an error.\n",
                "markdown": "> NewNTUnicodeString does not check for string length overflow. When provided with a string that overflows the maximum size of a NTUnicodeString (a 16-bit number of bytes), it returns a truncated string rather than an error.\n\n|                                                                               |\n|Package         pkg:golang/golang.org/x/sys@0.0.0-20220715151400-c0bba94af5f8  |\n|Affected range  <0.44.0                                                        |\n|Fixed version   0.44.0                                                         |\n"
              },
              "properties": {
