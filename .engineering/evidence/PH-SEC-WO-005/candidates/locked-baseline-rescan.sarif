            {
              "id": "CVE-2026-56852",
              "name": "OsPackageVulnerability",
              "shortDescription": {
                "text": "CVE-2026-56852"
              },
              "helpUri": "https://scout.docker.com/v/CVE-2026-56852?s=golang&n=text&ns=golang.org%2Fx&t=golang&vr=%3C0.39.0",
              "help": {
                "text": "A norm.Iter can enter an infinite loop when handling input containing invalid UTF-8 bytes.\n",
                "markdown": "> A norm.Iter can enter an infinite loop when handling input containing invalid UTF-8 bytes.\n\n|                                                     |\n|Package         pkg:golang/golang.org/x/text@0.38.0  |\n|Affected range  <0.39.0                              |\n|Fixed version   0.39.0                               |\n"
              },
              "properties": {
                "affected_version": "<0.39.0",
                "cvssV3_severity": "UNSPECIFIED",
